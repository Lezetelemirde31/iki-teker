# Copy to .env.local for development, or set these on the host in production.
# Nothing here is secret by default — the values that will be are marked.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# The app reads from the mock dataset unless one of these says otherwise.
# That is deliberate: the deployed demo has no database, and mocks let every
# screen work anyway.

# Hosted Postgres. Setting this switches the whole app to the database.
# DATABASE_URL=postgres://user:password@host:5432/ikitekerli

# Use the embedded PGlite database in development without a hosted server.
# USE_LOCAL_DB=1

# Where PGlite keeps its files. Default: ./.pglite
# PGLITE_DIR=./.pglite

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------
# Base URL for canonical links, hreflang alternates and Open Graph images.
#
# Set this ONLY once the domain actually resolves to the deployment. Until
# then, leave it unset: canonical tags pointing at a host that does not answer
# are worse for search engines than no canonical tags at all. Vercel's own
# production URL is used automatically in the meantime.
# NEXT_PUBLIC_SITE_URL=https://ikitekerli.az

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
# Emits the standalone server the container image copies. Set by the
# Dockerfile; leave unset everywhere else so the normal build is unchanged.
# BUILD_STANDALONE=1

# ---------------------------------------------------------------------------
# Maintenance
# ---------------------------------------------------------------------------
# Lets db:seed clear a lock left behind by a dev server that was killed
# mid-run. Only use it when nothing is actually holding the database.
# FORCE_UNLOCK=1
